# Wing Facility Monitor – Environment Variables
# Copy this file to .env and fill in your values

# Provider name from the Google Cloud sign-in page
PROVIDER_NAME=locations/global/workforcePools/wing-doordash-users/providers/google-saml

# Your Google account credentials
GOOGLE_EMAIL=you@example.com
GOOGLE_PASSWORD=your_google_password

# Slack Incoming Webhook URL
# How to get one: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
